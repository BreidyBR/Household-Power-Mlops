# ==============================
# Python
# ==============================
__pycache__/
*.py[cod]
*$py.class

# ==============================
# Virtual environments
# ==============================
.venv/
venv/
env/

# ==============================
# Environment variables / secrets
# ==============================
.env
.env.*
!.env.example

# ==============================
# Jupyter
# ==============================
.ipynb_checkpoints/

# ==============================
# IDE / Editor
# ==============================
.vscode/
.idea/

# ==============================
# Operating system
# ==============================
.DS_Store
Thumbs.db

# ==============================
# Raw and generated data
# ==============================
data/raw/*
data/interim/*
data/processed/*
data/production/*

# Keep directory structure in Git
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/production/.gitkeep

# ==============================
# MLflow local artifacts
# ==============================
mlruns/
mlartifacts/
mlflow.db
mlflow.db-*

# ==============================
# Model artifacts
# ==============================
*.pkl
*.joblib
*.pickle

# ==============================
# Logs
# ==============================
*.log
logs/

# ==============================
# Testing / coverage
# ==============================
.pytest_cache/
.coverage
htmlcov/

# ==============================
# Temporary files
# ==============================
*.tmp
*.temp
~$*